# Copia este archivo a .env y rellena tus claves reales.
# Las consigues en https://dashboard.stripe.com/apikeys (modo test primero)

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Usuario/contraseña para acceder al panel de admin (/admin)
ADMIN_USER=pablo
ADMIN_PASSWORD=cambia-esto

# Puerto del servidor
PORT=3000

# URL pública del sitio (la necesitas para las redirecciones de Stripe)
SITE_URL=http://localhost:3000
